{
  "name": "astrafactory-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "bun build src/ui/index.tsx --outdir dist --target browser --minify",
    "dev": "bun run build:ui && bun src/main/server.ts",
    "desktop": "bun run build:ui && bun scripts/desktop.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "electrobun": "2.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.0"
  }
}