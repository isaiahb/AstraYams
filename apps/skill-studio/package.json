  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
